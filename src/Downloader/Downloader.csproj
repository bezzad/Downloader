        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>Downloader.snk</AssemblyOriginatorKeyFile>
        <Copyright>Copyright (C) 2019-2026 Behzad Khosravifar</Copyright>
        <PackageIcon>downloader.png</PackageIcon>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <DebugType>embedded</DebugType>
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- Optional: Publish the repository URL in the built .nupkg (in the NuSpec <Repository> element) -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>

        <!-- Symbols travel INSIDE the package: DebugType=embedded puts the Source Link PDB in the DLL,
             so we do NOT build a separate symbol package. A .snupkg would contain no .pdb and nuget.org's
             symbol server rejects it with 400 "does not contain any symbol (.pdb) files". -->
        <IncludeSymbols>false</IncludeSymbols>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    </PropertyGroup>

    <!-- Enable AOT Native Package -->
    <PropertyGroup>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
        <PublishAot>true</PublishAot>
        <IsAotCompatible>true</IsAotCompatible>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <OptimizationPreference>Speed</OptimizationPreference>
        <StackTraceLineNumbers>true</StackTraceLineNumbers>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugType>full</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

