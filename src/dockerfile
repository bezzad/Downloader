# Use the official Microsoft .NET 10 SDK image as the base image
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

# Set the working directory in the container
WORKDIR /app

# Copy the test project files into the container
COPY . ./

# Build the project (only net10.0: the .NET 11 preview SDK is not in this image)
RUN dotnet restore -p:TargetFrameworks=net10.0
RUN dotnet build --configuration Release --no-restore -verbosity:m -p:TargetFrameworks=net10.0

# Set the entrypoint
ENTRYPOINT dotnet test --configuration Release --no-build -p:TargetFrameworks=net10.0 --logger "console;verbosity=detailed"
